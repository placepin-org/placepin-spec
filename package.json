  "keywords": [
    "placepin",
    "conformance",
    "test-vectors",
    "geocode",
    "specification"
  ],
  "homepage": "https://placepin.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/placepin-org/placepin-spec.git"
  },
  "license": "Apache-2.0",
  "author": "placepin.org",
  "type": "module",
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts",
    "vectors.json",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
